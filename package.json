{
  "name": "@intrusionshield/platform-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "clean": "pnpm -r --if-present run clean",
    "lint": "pnpm -r --if-present run lint",
    "sterile:preview": "node scripts/sterile-preview.mjs",
    "sterile:account": "node scripts/sterile-account.mjs",
    "sterile:account:check": "node scripts/sterile-account-check.mjs",
    "sterile:account:prepare-administrator": "node scripts/sterile-account-prepare-administrator.mjs",
    "sterile:account:prepare-access-admin": "node scripts/sterile-account-prepare-access-admin.mjs",
    "sterile:account:access": "node scripts/sterile-account-access.mjs",
    "sterile:account:prepare-test-users": "node scripts/sterile-account-prepare-test-users.mjs",
    "test:athena-access": "pnpm --filter @intrusionshield/authentication-service... build && pnpm --filter @intrusionshield/his-service... build && node --test services/authentication/tests/athenaHisAccess.integration.mjs apps/admin-portal/tests/hisFetch.test.mjs"
  }
}
