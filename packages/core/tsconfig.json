{
"extends": "../../tsconfig.json",

"compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "isolatedModules": true,

    "types": [
        "node"
    ]
},

"include": [
    "src/**/*.ts"
],

"exclude": [
    "node_modules",
    "dist"
]

}
