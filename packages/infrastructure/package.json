{
  "name": "@intrusionshield/infrastructure",
  "version": "1.0.0",
  "description": "Enterprise infrastructure services for the IntrusionShield Platform.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@intrusionshield/config": "workspace:*",
    "@intrusionshield/core": "workspace:*",
    "@intrusionshield/di": "workspace:*",
    "@intrusionshield/platform-kernel": "workspace:*",
    "mssql": "^11.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}