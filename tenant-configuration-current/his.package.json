{
  "name": "@intrusionshield/his-service",
  "version": "1.0.0",
  "description": "Athena Hospital Information System service for EIS.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config=jest.config.mjs --passWithNoTests",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config=jest.config.mjs --passWithNoTests --watch",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config=jest.config.mjs --runInBand repository.integration.test.ts person-list.integration.test.ts person-facility-list.integration.test.ts person-facility-affiliation-mutation.integration.test.ts"
  },
  "dependencies": {
    "@intrusionshield/config": "workspace:*",
    "@intrusionshield/database": "workspace:*",
    "@intrusionshield/his": "workspace:*",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "jest": "^30.2.0",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}