import {
    useEffect,
    useMemo,
    useState,
    type CSSProperties
} from "react";

import {
    useI18n
} from "./i18n/index.js";

type SchedulingPanelProps = {
    tenantId: string;
    onClose: () => void;
};

type PractitionerOption = {
    id: string;
    practitionerNumber?: string;
    personId?: string;
    displayName?: string;
    name?: string;
    firstName?: string;
    lastName?: string;
};

type FacilityOption = {
    id: string;
    code: string;
    name: string;
    facilityType?: string;
};

type ClinicalLocationOption = {
    id: string;
    facilityId?: string;
    code?: string;
    name: string;
    locationType?: string;
    active?: boolean;
};

type PatientOption = {
    id: string;
    personId: string;
    patientNumber: string;
    medicalRecordNumber: string;
    status: string;
    firstName: string;
    middleName?: string;
    lastName: string;
    preferredName?: string;
};

type AppointmentType =
    | "CONSULTATION"
    | "FOLLOW_UP"
    | "PROCEDURE"
    | "DIAGNOSTIC"
    | "THERAPY"
    | "VIRTUAL"
    | "OTHER";

type Appointment = {
    id: string;
    appointmentNumber: string;
    patientId: string;
    facilityId: string;
    practitionerId?: string;
    clinicalLocationId?: string;
    appointmentType: AppointmentType;
    status: string;
    source: string;
    scheduledStart: string;
    scheduledEnd: string;
    reason?: string;
    notes?: string;
    cancellationReason?: string;
    version?: number;
};

type AvailabilitySlot = {
    start: string;
    end: string;
};

type AvailabilitySlotResponse = {
    practitionerId?: string;
    clinicalLocationId?: string;
    from: string;
    to: string;
    durationMinutes: number;
    timeZone: string;
    slots: AvailabilitySlot[];
};

type ApiCollection<T> =
    | T[]
    | {
        items?: T[];
        data?: T[];
    };

const APPOINTMENT_TYPES: ReadonlyArray<{
    value: AppointmentType;
    label: string;
}> = [
    {
        value: "CONSULTATION",
        label: "Consultation"
    },
    {
        value: "FOLLOW_UP",
        label: "Follow-up"
    },
    {
        value: "PROCEDURE",
        label: "Procedure"
    },
    {
        value: "DIAGNOSTIC",
        label: "Diagnostic"
    },
    {
        value: "THERAPY",
        label: "Therapy"
    },
    {
        value: "VIRTUAL",
        label: "Virtual"
    },
    {
        value: "OTHER",
        label: "Other"
    }
];

