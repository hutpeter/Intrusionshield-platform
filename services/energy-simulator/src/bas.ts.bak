/** BAS phase 1: simulated single-zone HVAC telemetry and command execution. */

const baseUrl =
    process.env.TELEMETRY_ENERGY_BASE_URL ??
    "http://localhost:4401";

const tenantId =
    process.env.SIMULATOR_TENANT_ID ??
    "73c28616-633a-46b5-bd4d-2ad7971af02c";

const siteId =
    process.env.SIMULATOR_SITE_ID ??
    "138c8b96-04ae-402d-93f9-89b3677734e1";

const intervalMs =
    positive(process.env.BAS_INTERVAL_MS, 5000);

const stepMinutes =
    positive(process.env.BAS_STEP_MINUTES, 5);

const commandPollMs =
    positive(process.env.BAS_COMMAND_POLL_MS, 2000);

const deviceCode =
    process.env.BAS_DEVICE_CODE ??
    "HVAC-COMM-44092";

const defaultSetpointF =
    positive(
        process.env.BAS_DEFAULT_SETPOINT_F,
        72
    );

type RecordWithId = {
    id: string;
    code: string;
};

type State =
    | "COOLING"
    | "OFF";

interface Zone {
    temperatureF: number;
    setpointF: number;
    humidity: number;
    state: State;
    time: Date;
}

interface BasCommand {
    id: string;
    tenantId: string;
    siteId: string;
    assetId?: string;
    deviceId?: string;
    commandType: string;
    commandPayload: Record<string, unknown>;
    status:
        | "PENDING"
        | "ACCEPTED"
        | "EXECUTED"
        | "FAILED";
    version: number;
}

async function request<T>(
    path: string,
    method: "GET" | "POST" | "PATCH" = "GET",
    body?: object
): Promise<T> {
    const response =
        await fetch(
            `${baseUrl}${path}`,
            {
                method,
                headers: {
                    "x-tenant-id": tenantId,
                    "Content-Type":
                        "application/json"
                },
                body:
                    body !== undefined
                        ? JSON.stringify(body)
                        : undefined
            }
        );

    const value =
        await response.text();

    if (!response.ok) {
        throw new Error(
            `${method} ${path}: ${response.status} ${value}`
        );
    }

    return value
        ? JSON.parse(value) as T
        : undefined as T;
}

async function ensure<T extends RecordWithId>(
    list: T[],
    code: string,
    endpoint: string,
    body: object
): Promise<T> {
    const found =
        list.find(
            item =>
                item.code === code
        );

    if (found) {
        return found;
    }

    const created =
        await request<T>(
            endpoint,
            "POST",
            {
                code,
                ...body
            }
        );

    list.push(created);

    return created;
}

function positive(
    raw: string | undefined,
    fallback: number
): number {
    const value =
        raw === undefined
            ? fallback
            : Number(raw);

    if (
        !Number.isFinite(value) ||
        value <= 0
    ) {
        throw new Error(
            "BAS cadence and numeric settings must be positive numbers."
        );
    }

    return value;
}

function round(
    value: number
): number {
    return Math.round(
        value * 100
    ) / 100;
}

function getCommandSetpoint(
    command: BasCommand
): number {
    const raw =
        command.commandPayload?.setpointF;

    const value =
        typeof raw === "number"
            ? raw
            : Number(raw);

    if (
        !Number.isFinite(value) ||
        value < 60 ||
        value > 85
    ) {
        throw new Error(
            "SET_TEMPERATURE setpointF must be between 60 and 85 F."
        );
    }

    return value;
}

export function advance(
    zone: Zone,
    minutes: number
): Zone {
    const deadband = 0.5;

    let state: State;

    if (
        zone.state === "COOLING"
    ) {
        state =
            zone.temperatureF <=
            zone.setpointF + deadband
                ? "OFF"
                : "COOLING";
    } else {
        state =
            zone.temperatureF >=
            zone.setpointF + deadband
                ? "COOLING"
                : "OFF";
    }

    const hours =
        minutes / 60;

    const temperatureF =
        Math.max(
            65,
            Math.min(
                85,
                zone.temperatureF +
                    (
                        state === "COOLING"
                            ? -1.9
                            : 1.15
                    ) *
                    hours
            )
        );

    const humidity =
        Math.max(
            25,
            Math.min(
                70,
                zone.humidity +
                    (
                        state === "COOLING"
                            ? -2.3
                            : 0.85
                    ) *
                    hours
            )
        );

    return {
        temperatureF,
        setpointF:
            zone.setpointF,
        humidity,
        state,
        time:
            new Date(
                zone.time.getTime() +
                minutes * 60000
            )
    };
}

async function findPendingCommands(
    deviceId: string
): Promise<BasCommand[]> {
    return request<BasCommand[]>(
        `/api/v1/energy/bas/commands?deviceId=${encodeURIComponent(deviceId)}&status=PENDING`
    );
}

async function acceptCommand(
    commandId: string,
    version: number
): Promise<BasCommand> {
    return request<BasCommand>(
        `/api/v1/energy/bas/commands/${commandId}/accept`,
        "POST",
        {
            version
        }
    );
}

async function executeCommand(
    commandId: string,
    version: number
): Promise<BasCommand> {
    return request<BasCommand>(
        `/api/v1/energy/bas/commands/${commandId}/execute`,
        "POST",
        {
            version
        }
    );
}

async function failCommand(
    commandId: string,
    version: number,
    failureMessage: string
): Promise<BasCommand> {
    return request<BasCommand>(
        `/api/v1/energy/bas/commands/${commandId}/fail`,
        "POST",
        {
            version,
            failureCode:
                "SIMULATOR_COMMAND_FAILURE",
            failureMessage
        }
    );
}

async function processCommands(
    deviceId: string,
    zone: Zone
): Promise<Zone> {
    const commands =
        await findPendingCommands(
            deviceId
        );

    let currentZone =
        zone;

    for (
        const command of commands
    ) {
        try {
            if (
                command.commandType !==
                "SET_TEMPERATURE"
            ) {
                await failCommand(
                    command.id,
                    command.version,
                    `Unsupported BAS command type: ${command.commandType}`
                );

                continue;
            }

            /*
             * The repository uses optimistic
             * version checking, so the command's
             * current version must accompany
             * each state transition.
             */
            const accepted =
                await acceptCommand(
                    command.id,
                    command.version
                );

            const setpointF =
                getCommandSetpoint(
                    command
                );

            currentZone = {
                ...currentZone,
                setpointF
            };

            await executeCommand(
                command.id,
                accepted.version
            );

            console.log(
                `BAS command executed: ${command.id} ` +
                `SET_TEMPERATURE ${setpointF} F`
            );
        } catch (error) {
            const message =
                error instanceof Error
                    ? error.message
                    : String(error);

            console.error(
                `BAS command failed: ${command.id}: ${message}`
            );

            try {
                /*
                 * If ACCEPTED succeeded, use the
                 * returned version. Otherwise the
                 * original version is still current.
                 */
                const currentVersion =
                    typeof command.version ===
                    "number"
                        ? command.version
                        : 1;

                await failCommand(
                    command.id,
                    currentVersion,
                    message
                );
            } catch (
                failureError
            ) {
                console.error(
                    `Unable to mark BAS command ${command.id} FAILED:`,
                    failureError
                );
            }
        }
    }

    return currentZone;
}

async function main(): Promise<void> {
    await request(
        `/api/v1/telemetry/sites/${siteId}`
    );

    const assets =
        await request<RecordWithId[]>(
            `/api/v1/telemetry/sites/${siteId}/assets`
        );

    const asset =
        await ensure(
            assets,
            "BAS-ZONE-001",
            "/api/v1/telemetry/assets",
            {
                siteId,
                name:
                    "BAS Sample Zone",
                assetType:
                    "HVAC_ZONE",
                status:
                    "ACTIVE"
            }
        );

    const devices =
        await request<RecordWithId[]>(
            `/api/v1/telemetry/sites/${siteId}/devices`
        );

    const device =
        await ensure(
            devices,
            deviceCode,
            "/api/v1/telemetry/devices",
            {
                siteId,
                assetId:
                    asset.id,
                name:
                    "Sample HVAC Controller",
                deviceType:
                    "HVAC_CONTROLLER",
                protocol:
                    "SIMULATOR",
                externalDeviceId:
                    deviceCode,
                status:
                    "ONLINE"
            }
        );

    const definitions =
        await request<RecordWithId[]>(
            "/api/v1/telemetry/measurement-definitions"
        );

    const temperature =
        await ensure(
            definitions,
            "bas.zone.temperature",
            "/api/v1/telemetry/measurement-definitions",
            {
                name:
                    "Zone Temperature",
                unit:
                    "F",
                dataType:
                    "NUMBER",
                minimumValue:
                    -40,
                maximumValue:
                    140
            }
        );

    const humidity =
        await ensure(
            definitions,
            "bas.zone.humidity",
            "/api/v1/telemetry/measurement-definitions",
            {
                name:
                    "Zone Relative Humidity",
                unit:
                    "%",
                dataType:
                    "NUMBER",
                minimumValue:
                    0,
                maximumValue:
                    100
            }
        );

    const operatingState =
        await ensure(
            definitions,
            "hvac.operating_state",
            "/api/v1/telemetry/measurement-definitions",
            {
                name:
                    "HVAC Operating State",
                dataType:
                    "STRING"
            }
        );

    let zone: Zone = {
        temperatureF:
            72.5,
        setpointF:
            defaultSetpointF,
        humidity:
            45.2,
        state:
            "COOLING",
        time:
            new Date()
    };

    let telemetryBusy =
        false;

    let commandBusy =
        false;

    const processPendingCommands =
        async (): Promise<void> => {
            if (commandBusy) {
                return;
            }

            commandBusy = true;

            try {
                zone =
                    await processCommands(
                        device.id,
                        zone
                    );
            } catch (error) {
                console.error(
                    "BAS command polling failed:",
                    error
                );
            } finally {
                commandBusy =
                    false;
            }
        };

    const tick =
        async (): Promise<void> => {
            if (telemetryBusy) {
                return;
            }

            telemetryBusy =
                true;

            try {
                const observedAt =
                    zone.time.toISOString();

                for (
                    const [
                        definition,
                        value
                    ] of [
                        [
                            temperature,
                            {
                                numericValue:
                                    round(
                                        zone.temperatureF
                                    )
                            }
                        ],
                        [
                            humidity,
                            {
                                numericValue:
                                    round(
                                        zone.humidity
                                    )
                            }
                        ],
                        [
                            operatingState,
                            {
                                stringValue:
                                    zone.state
                            }
                        ]
                    ] as const
                ) {
                    await request(
                        "/api/v1/telemetry/readings",
                        "POST",
                        {
                            siteId,
                            deviceId:
                                device.id,
                            measurementDefinitionId:
                                definition.id,
                            observedAt,
                            ...value,
                            quality:
                                "GOOD",
                            source:
                                "simulator.bas"
                        }
                    );
                }

                console.log(
                    `${observedAt} ` +
                    `${deviceCode} ` +
                    `${round(zone.temperatureF)} F ` +
                    `${round(zone.humidity)} % ` +
                    `${zone.state} ` +
                    `SETPOINT ${round(zone.setpointF)} F`
                );

                zone =
                    advance(
                        zone,
                        stepMinutes
                    );
            } catch (error) {
                console.error(
                    "BAS sample failed:",
                    error
                );
            } finally {
                telemetryBusy =
                    false;
            }
        };

    console.log(
        `BAS simulator: ${deviceCode}, ` +
        `site ${siteId}, ` +
        `telemetry every ${intervalMs} ms, ` +
        `command polling every ${commandPollMs} ms`
    );

    /*
     * Process commands that may already
     * be waiting before the first sample.
     */
    await processPendingCommands();

    /*
     * Produce the first telemetry sample.
     */
    await tick();

    /*
     * Independent telemetry loop.
     */
    setInterval(
        () => {
            void tick();
        },
        intervalMs
    );

    /*
     * Independent BAS command loop.
     */
    setInterval(
        () => {
            void processPendingCommands();
        },
        commandPollMs
    );
}

if (
    process.env.BAS_SIMULATOR_TEST !==
    "1"
) {
    void main().catch(
        error => {
            console.error(
                error
            );
            process.exitCode =
                1;
        }
    );
}