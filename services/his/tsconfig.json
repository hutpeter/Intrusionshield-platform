{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "src/app.ts",
    "src/index.ts",
    "src/application/**/*.ts",
    "src/controllers/**/*.ts",
    "src/infrastructure/**/*.ts",
    "src/middleware/**/*.ts",
    "src/routes/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/__tests__"
  ]
}