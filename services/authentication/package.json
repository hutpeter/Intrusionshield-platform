    "@intrusionshield/tenant-configuration": "workspace:*",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
