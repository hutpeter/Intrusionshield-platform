{
  "name": "@intrusionshield/authentication-service",
  "version": "1.0.0",
  "description": "EIS authentication service.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
